<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>ShieldBlock.Service</RootNamespace>
    <AssemblyName>ShieldBlockService</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ShieldBlock.Core\**\*.cs" Exclude="..\ShieldBlock.Core\obj\**;..\ShieldBlock.Core\bin\**" Link="Core\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
